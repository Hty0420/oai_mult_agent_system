    "negative_result_is_valid_completion": true,
    "natural_language_reporting": {
      "source": "independently_audited_structured_facts_only",
      "fixed_wording_prohibited": true,
      "numeric_and_direction_validation_required": true,
      "safety_fallback": "deterministic_summary_after_two_failed_drafts"
    }
  },
  "unsupported_claims": [
    "causal biomarker",
    "longitudinal progression biomarker",
    "surrogate endpoint",
    "clinical diagnostic biomarker",
    "external validation without an independent cohort"
  ]
