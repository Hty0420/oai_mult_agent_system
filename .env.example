# ==================== LLM API Configuration ====================
# All agents and the chatbot read model/base_url/api_key_env from llm_config.json.
# Default: DeepSeek. Store the key here, not in llm_config.json.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional: set api_key_env to OPENAI_API_KEY in llm_config.json to use this key.
OPENAI_API_KEY=your_openai_api_key_here

# Deployment label persisted with every new task trajectory. Change this when
# prompts, tools, orchestration logic, or the deployed Agent bundle changes.
MULTI_AGENT_VERSION=multi-agent-v1
# Active decision policy; policy and Agent code versions are tracked separately.
MULTI_AGENT_POLICY_ID=baseline-v1
# Optional. Defaults to output/scientific_trajectory_graphs under the project.
# Every terminal task writes a PNG overview, Markdown report, and JSON manifest.
SCIENTIFIC_TRAJECTORY_DIR=

# Alternative backend credentials (optional; select via llm_config.json)
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ==================== LangSmith (Optional) ====================
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ==================== Web Search ====================
ZHIPU_API_KEY=your_zhipu_api_key_here
