# ==================== LLM API Configuration ====================
# Primary LLM (used by all agents via ChatOpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

# Deployment label persisted with every new task trajectory. Change this when
# prompts, tools, orchestration logic, or the deployed Agent bundle changes.
MULTI_AGENT_VERSION=multi-agent-v1
# Active decision policy; policy and Agent code versions are tracked separately.
MULTI_AGENT_POLICY_ID=baseline-v1

# Alternative LLM backends (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ==================== LangSmith (Optional) ====================
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ==================== Web Search ====================
ZHIPU_API_KEY=your_zhipu_api_key_here
